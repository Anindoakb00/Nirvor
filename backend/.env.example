# ==============================================================================
# 1. BASETEN API CONFIGURATION ($100 Hackathon Credits - 2M Tokens/Min)
# Primary engine for high-throughput Multimodal OCR & Clinical Reasoning
# ==============================================================================
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# ==============================================================================
# 2. OFFICIAL META MODEL API ($150 Hackathon Credits - dev.meta.ai)
# Single API key unlocks ALL specialized Meta models below
# ==============================================================================
META_API_KEY=your_meta_api_key_here
META_BASE_URL=https://api.meta.ai/v1

# Model Routing Identifiers
META_SPARK_MODEL=muse-spark-1.3-contributor
META_WONDER_MODEL=muse-wonder
META_VOICE_MODEL=muse-voice-transcribe
META_IMAGE_MODEL=muse-image-1.0
META_SAM_MODEL=sam-3.1

# ==============================================================================
# 3. MODAL SERVERLESS GPU CONFIGURATION ($101 Hackathon Credits)
# Note: Modal authenticates via C:\Users\Anindo\.modal.toml (from `modal setup`)
# ==============================================================================
MODAL_APP_NAME=sonakto-v2-cloud-worker
USE_MODAL_CLOUD=false